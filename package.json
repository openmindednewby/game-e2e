{
  "name": "@dloizides/game-e2e",
  "version": "1.0.0",
  "description": "Playwright helpers shared by the EisaiPollis browser games: phone/desktop device projects, a simulated browser-toolbar visible height, game-shell fit assertions, DOM control boxes and overlap math, exact or tolerant PNG pixel/region diff, and the 44x44 touch-target and no-horizontal-scroll mobile gates. Extracted from Aurora, Surge and Morphe.",
  "keywords": [
    "playwright",
    "e2e",
    "game",
    "mobile-first",
    "pixel-diff",
    "touch-targets",
    "eisaipollis"
  ],
  "author": "dloizides",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/openmindednewby/game-e2e.git"
  },
  "homepage": "https://github.com/openmindednewby/game-e2e#readme",
  "bugs": {
    "url": "https://github.com/openmindednewby/game-e2e/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "default": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "rimraf dist && tsup",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "clean": "rimraf dist",
    "security:audit": "npm audit --audit-level=high",
    "prepublishOnly": "npm run clean && npm run build && npm run test"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.57.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.19.32",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "rimraf": "^5.0.0",
    "ts-jest": "^29.1.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  }
}
